import re
import json
from pathlib import Path
import httpx

# 1. Search for live working tokens across known source files
candidate_tokens = set()
search_dirs = [Path("C:/Quant-Nexus-Eng"), Path("C:/Quant-Nexus-Prod")]

for d in search_dirs:
    if not d.exists(): continue
    for ext in ["*.py", "*.json", "*.txt", "*.cfg"]:
        for p in d.rglob(ext):
            try:
                content = p.read_text(encoding="utf-8", errors="ignore")
                matches = re.findall(r"(\d{8,11}:[A-Za-z0-9_-]{35})", content)
                for m in matches:
                    candidate_tokens.add(m)
            except Exception:
                pass

token_map = {}
for tok in candidate_tokens:
    try:
        r = httpx.get(f"https://api.telegram.org/bot{tok}/getMe", timeout=5.0)
        if r.status_code == 200:
            data = r.json().get("result", {})
            b_id = data.get("id")
            b_name = data.get("first_name")
            b_user = data.get("username", "").lower()
            token_map[b_id] = (tok, b_name, b_user)
    except Exception:
        pass

# Match tokens by Bot ID
# Quant Alert Bot: ID 8883861115
