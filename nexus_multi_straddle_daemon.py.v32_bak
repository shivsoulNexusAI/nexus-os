from datetime import datetime, timezone, timedelta
import MetaTrader5 as mt5

# Wire Nexus-OS core modules
NEXUS_OS_PATH = r"C:\Quant-Nexus-OS"
if NEXUS_OS_PATH not in sys.path:
    sys.path.insert(0, NEXUS_OS_PATH)

try:
    from core.anti_whipsaw import AntiWhipsawEngine
    from core.nexus_signal_engine import NexusSignalEngine
except Exception:
    AntiWhipsawEngine = None
    NexusSignalEngine = None

TERMINAL = r"C:/MT5_Quant_278017866/terminal64.exe"
MODEL_PATH = r"C:\Quant-Nexus-Eng\regime_classifier.pkl"
MICRO_STATE_PATH = Path(r"C:\Quant-Nexus-Eng\microstructure_state.json")
LOG_FILE = r"C:\Quant-Nexus-Eng\nexus_multi_straddle.log"

SYMBOLS = ["BTCUSD", "XAUUSD", "US30", "EURUSD", "GBPUSD", "USDJPY"]
MICRO_GATED_SYMBOLS = {"BTCUSD", "XAUUSD", "US30", "EURUSD", "GBPUSD", "USDJPY"}

# Calibrated Regime ML Decision Hurdles by Asset Profile
ASSET_THRESHOLDS = {
    "EURUSD": 0.70,
    "GBPUSD": 0.70,
    "USDJPY": 0.65,
    "US30":   0.68,
    "XAUUSD": 0.72,
    "BTCUSD": 0.72
}
DEFAULT_THRESHOLD = 0.65
POLL_INTERVAL = 60

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    handlers=[
        logging.FileHandler(LOG_FILE, mode="a", encoding="utf-8"),
        logging.StreamHandler(sys.stdout)
    ]
)

class DualGatedDynamicEngine:
    def __init__(self):
        logging.info("=" * 90)
        logging.info("   NEXUS ENGINE V3.2 CALIBRATED ONLINE (2025-2026 VALIDATED) (BREAKOUT + DII FADE): ML + ATR + MICROSTRUCTURE VPOC/DELTA + NEXUS-OS SHIELD")
        logging.info("=" * 90)

        if not mt5.initialize(path=TERMINAL, portable=False):
            logging.error(f"MT5 Init Failed: {mt5.last_error()}")
            sys.exit(1)

        self.model_bundle = None
        self.load_model()
        self.spread_history = {s: [] for s in SYMBOLS}
        self.whipsaw = AntiWhipsawEngine(cooldown_sec=900, max_consecutive_losses=2, penalty_sec=3600) if AntiWhipsawEngine else None
        self.fade_engine = NexusSignalEngine(symbols=["XAUUSD", "BTCUSD", "EURUSD"]) if NexusSignalEngine else None
        self.processed_deals = set()

    def load_model(self):
        try:
            import joblib
            from sklearn.ensemble import HistGradientBoostingClassifier  # noqa: F401
            self.model_bundle = joblib.load(MODEL_PATH)
            logging.info(f"[ML ENGINE LOADED] Regime model ready via joblib (AUC: {self.model_bundle.get('auc', 0.5):.4f})")
        except Exception as e:
            logging.warning(f"ML model load fallback ({e}). Enforcing strict ATR expansion ratio >= 1.15.")
            self.model_bundle = None

    def sync_whipsaw_history(self):
        """Syncs recent closed exits using actual deal exit timestamps."""
        if not self.whipsaw:
            return
        now = datetime.now()
        ref_tick = mt5.symbol_info_tick('EURUSD'); now_ts = int(ref_tick.time) if ref_tick else int(time.time())
        deals = mt5.history_deals_get(now - timedelta(hours=2), now) or []
        for d in sorted(deals, key=lambda x: x.time):
            if d.entry == 1 and d.ticket not in self.processed_deals:
                self.processed_deals.add(d.ticket)
                if d.symbol in SYMBOLS and 0 <= (now_ts - d.time) <= 3600:
                    if d.profit < -0.10:
                        self.whipsaw.record_loss(d.symbol)
                    elif d.profit > 0.10:
                        self.whipsaw.record_win(d.symbol)

    def is_macro_news_blackout(self) -> bool:
        """Blocks 13:25 to 13:40 MT5 server time (US CPI / NFP spike window)."""
        tick = mt5.symbol_info_tick("EURUSD")
        srv_dt = datetime.fromtimestamp(tick.time, tz=timezone.utc) if tick else datetime.now(timezone.utc)
        if srv_dt.hour == 13 and 25 <= srv_dt.minute <= 40:
            return True
        return False

    def read_microstructure(self, symbol: str) -> dict | None:
        """Sub-millisecond atomic read from microstructure_state.json."""
        if not MICRO_STATE_PATH.exists():
            return None
        try:
            with open(MICRO_STATE_PATH, "r", encoding="utf-8") as f:
                data = json.load(f)
            ts = datetime.fromisoformat(data.get("timestamp", "2000-01-01T00:00:00"))
            if (datetime.now() - ts).total_seconds() > 15:
                return None  # Stale cache fail-open
            return data.get("fleet", {}).get(symbol)
        except Exception:
            return None

    def purge_stale_orders(self, max_age_seconds=3600):
        orders = mt5.orders_get() or []
        now_ts = int(time.time())
        for o in orders:
            if "NEXUS" in o.comment:
                order_age = now_ts - o.time_setup
                if order_age > max_age_seconds:
                    res = mt5.order_send({"action": mt5.TRADE_ACTION_REMOVE, "order": o.ticket})
                    if res and res.retcode == mt5.TRADE_RETCODE_DONE:
                        logging.info(f"[STALE PURGE] Removed pending order #{o.ticket} ({o.symbol}) after {order_age}s.")

    def enforce_symbol_level_oco_and_cap(self, max_total_assets=4):
        """Enforces per-symbol OCO and counts BOTH open positions and working pending symbols toward the 4-asset cap."""
        positions = mt5.positions_get() or []
        orders = mt5.orders_get() or []
        active_symbols = {p.symbol for p in positions}

        for o in orders:
            if o.symbol in active_symbols and "NEXUS" in o.comment:
                res = mt5.order_send({"action": mt5.TRADE_ACTION_REMOVE, "order": o.ticket})
                if res and res.retcode == mt5.TRADE_RETCODE_DONE:
                    logging.info(f"[PER-SYMBOL OCO] Cancelled opposite pending leg #{o.ticket} on {o.symbol} (trade active).")

        # Refresh working pending symbols after OCO cleanup
        rem_orders = mt5.orders_get() or []
        pending_symbols = {o.symbol for o in rem_orders if "NEXUS" in o.comment}
        total_engaged = active_symbols | pending_symbols
        return len(total_engaged) >= max_total_assets, total_engaged

    def get_features(self, symbol):
        rates = mt5.copy_rates_from_pos(symbol, mt5.TIMEFRAME_M5, 0, 100)
        if rates is None or len(rates) < 80:
            return None, None, None

        df = pd.DataFrame(rates)
        o, h, l, c, v = df["open"], df["high"], df["low"], df["close"], df["tick_volume"]

        prev_c = c.shift(1)
        tr = np.maximum(h - l, np.maximum((h - prev_c).abs(), (l - prev_c).abs()))
        atr14 = tr.rolling(14).mean()
        natr14 = (atr14 / c) * 100.0
        atr_baseline = tr.rolling(72).mean()

        cur_natr = natr14.iloc[-1]
        baseline_natr = natr14.rolling(72, min_periods=10).mean().iloc[-1]
        rel_natr = cur_natr / baseline_natr if baseline_natr > 0 else 1.0
        atr_exp_ratio = atr14.iloc[-1] / atr_baseline.iloc[-1] if atr_baseline.iloc[-1] > 0 else 1.0

        log_hl = np.log(h / l) ** 2
        p_vol = np.sqrt((1.0 / (4.0 * np.log(2.0))) * log_hl.rolling(14).mean()) * np.sqrt(288 * 365)
        p_vol_base = p_vol.rolling(72, min_periods=10).mean().iloc[-1]
        rel_p_vol = p_vol.iloc[-1] / p_vol_base if p_vol_base > 0 else 1.0

        log_co = np.log(c / o) ** 2
        gk_term = 0.5 * log_hl - (2.0 * np.log(2.0) - 1.0) * log_co
        gk_vol = np.sqrt(np.maximum(0, gk_term.rolling(14).mean())) * np.sqrt(288 * 365)
        gk_base = gk_vol.rolling(72, min_periods=10).mean().iloc[-1]
        rel_gk_vol = gk_vol.iloc[-1] / gk_base if gk_base > 0 else 1.0

        bar_range = max(h.iloc[-1] - l.iloc[-1], 1e-6)
        upper_wick = (h.iloc[-1] - max(o.iloc[-1], c.iloc[-1])) / bar_range
        lower_wick = (min(o.iloc[-1], c.iloc[-1]) - l.iloc[-1]) / bar_range
        body = abs(c.iloc[-1] - o.iloc[-1]) / bar_range
        rvol = v.iloc[-1] / v.rolling(24).mean().iloc[-1] if v.rolling(24).mean().iloc[-1] > 0 else 1.0

        ret_1 = (c.iloc[-1] / c.iloc[-2]) - 1.0
        ret_3 = (c.iloc[-1] / c.iloc[-4]) - 1.0
        ret_12 = (c.iloc[-1] / c.iloc[-13]) - 1.0

        feat_dict = {
            "rel_natr": rel_natr,
            "atr_expansion_ratio": atr_exp_ratio,
            "rel_parkinson": rel_p_vol,
            "rel_gk": rel_gk_vol,
            "upper_wick_ratio": upper_wick,
            "lower_wick_ratio": lower_wick,
            "body_ratio": body,
            "rvol": rvol,
            "ret_1": ret_1,
            "ret_3": ret_3,
            "ret_12": ret_12,
            "is_btc": 1 if symbol == "BTCUSD" else 0,
            "is_gold": 1 if symbol == "XAUUSD" else 0,
            "is_us30": 1 if symbol == "US30" else 0
        }

        feature_cols = self.model_bundle["feature_names"] if self.model_bundle else ["atr14", "atr_base", "expansion_ratio", "spread_ratio"]
        row = pd.DataFrame([[feat_dict.get(k, 0.0) for k in feature_cols]], columns=feature_cols)
        return row, atr14.iloc[-1], c.iloc[-1]

    def check_spread_elasticity(self, symbol, current_spread):
        hist = self.spread_history[symbol]
        hist.append(current_spread)
        if len(hist) > 60:
            hist.pop(0)
        if len(hist) >= 10:
            p90 = np.percentile(hist, 90)
            if current_spread > p90 * 1.5:
                return False, p90
        return True, current_spread

    def check_active_exposure(self, symbol):
        pos = mt5.positions_get(symbol=symbol) or []
        orders = mt5.orders_get(symbol=symbol) or []
        return len(pos), len(orders)

    def evaluate_and_dispatch_fade(self, sym: str, tick, info, engaged_syms: set) -> bool:
        """Secondary Mode: Nexus-OS DII Absorption/Divergence Mean-Reversion at VAL/VAH -> VPOC."""
        if not self.fade_engine or sym not in ("XAUUSD", "BTCUSD"):
            return False
        micro = self.read_microstructure(sym)
        if not micro or micro.get("inside_poc_chop", True):
            return False

        val = micro.get("val", 0.0)
        vah = micro.get("vah", 0.0)
        buf = info.point * (50 if "BTC" in sym else (30 if "XAU" in sym else 15))

        # Only invoke DII scan when price is actively probing Value Area boundaries
        if not (tick.bid <= val + buf or tick.ask >= vah - buf):
            return False

        sig = self.fade_engine.evaluate_symbol(sym)
        if not sig or sig.get("confidence", 0.0) < 0.65:
            return False

        side = sig["side"]
        if side == "BUY":
            return False  # Block bullish knife-catching fades per 2025-2026 backtest attribution
        price = tick.ask if side == "BUY" else tick.bid
        sl = round(float(sig["sl_price"]), info.digits)
        tp = round(float(sig["tp_price"]), info.digits)
        sl_dist = abs(price - sl)
        tp_dist = abs(tp - price)
        if sl_dist <= 0 or (tp_dist / sl_dist) < 1.3:
            return False

        lot = max(info.volume_min * 2.0, 0.02) if info.volume_min <= 0.01 else info.volume_min
        order_type = mt5.ORDER_TYPE_BUY if side == "BUY" else mt5.ORDER_TYPE_SELL
        req = {
            "action": mt5.TRADE_ACTION_DEAL,
            "symbol": sym,
            "volume": lot,
            "type": order_type,
            "price": price,
            "sl": sl,
            "tp": tp,
            "deviation": 30,
            "type_filling": mt5.ORDER_FILLING_IOC,
            "comment": "NEXUS_V3_FADE",
        }
        res = mt5.order_send(req)
        if res and res.retcode == mt5.TRADE_RETCODE_DONE:
            engaged_syms.add(sym)
            logging.info(
                f"[V3.1 FADE ARMED | {sig['setup']} | Conf={sig['confidence']:.2f} | VPOC={sig['vpoc']}] "
                f"{sym} {side} {lot}L @ {price:.{info.digits}f} | SL={sl:.{info.digits}f} | TP={tp:.{info.digits}f} (#{res.order})"
            )
            return True
        return False

    def cycle(self):
        self.sync_whipsaw_history()

        # 1. Macro News Blackout Guard (13:25 - 13:40 Server Time)
        if self.is_macro_news_blackout():
            for o in (mt5.orders_get() or []):
                if "NEXUS" in o.comment:
                    mt5.order_send({"action": mt5.TRADE_ACTION_REMOVE, "order": o.ticket})
            logging.info("[NEWS SHIELD] 13:30 US Macro Release Blackout Active — Pending straddles purged.")
            return

        # 2. Enforce OCO & Hard 4-Asset Total Cap (Open + Pending)
        fleet_saturated, engaged_syms = self.enforce_symbol_level_oco_and_cap(max_total_assets=4)
        self.purge_stale_orders()
        if fleet_saturated:
            return

        for sym in SYMBOLS:
            try:
                if len(engaged_syms) >= 4:
                    break

                # 3. Nexus-OS Anti-Whipsaw Quarantine Check
                if self.whipsaw:
                    locked, rem_sec = self.whipsaw.is_symbol_locked(sym)
                    if locked:
                        continue

                tick = mt5.symbol_info_tick(sym)
                info = mt5.symbol_info(sym)
                if not tick or not info:
                    continue

                spread_pts = (tick.ask - tick.bid) / info.point
                spread_ok, p90 = self.check_spread_elasticity(sym, spread_pts)
                if not spread_ok:
                    logging.info(f"[SPREAD GATE] {sym} spread {spread_pts:.1f}pt exceeds 90th percentile {p90:.1f}pt. Skipped.")
                    continue

                pos_count, order_count = self.check_active_exposure(sym)
                if pos_count > 0 or order_count > 0:
                    continue

                X, cur_atr, cur_price = self.get_features(sym)
                if X is None or cur_atr is None or cur_atr <= 0:
                    continue

                thresh = ASSET_THRESHOLDS.get(sym, DEFAULT_THRESHOLD)
                if self.model_bundle:
                    clf = self.model_bundle["model"]
                    p_expansion = clf.predict_proba(X)[0, 1]
                else:
                    exp_ratio = float(X["atr_expansion_ratio"].iloc[0]) if "atr_expansion_ratio" in X.columns else 1.0
                    p_expansion = min(0.95, max(0.0, (exp_ratio - 0.85) * 2.0))

                if p_expansion < thresh:
                    self.evaluate_and_dispatch_fade(sym, tick, info, engaged_syms)
                    continue

                # 4. Microstructure VPOC & Aggressor Delta Gate (XAUUSD & BTCUSD)
                allow_buy = True
                allow_sell = True
                micro_tag = "MACRO_ATR"
                if sym in MICRO_GATED_SYMBOLS:
                    micro = self.read_microstructure(sym)
                    if micro:
                        if micro.get("inside_poc_chop", False) or micro.get("regime") == "BALANCED_CHOP":
                            if not micro.get("inside_poc_chop", False):
                                self.evaluate_and_dispatch_fade(sym, tick, info, engaged_syms)
                            continue
                        regime = micro.get("regime", "")
                        delta_pct = micro.get("delta_pct", 0.0)
                        if regime == "STRONG_BULLISH_DELTA":
                            allow_sell = False
                            micro_tag = f"BULL_DELTA({delta_pct:+.1f}%)"
                        elif regime == "STRONG_BEARISH_DELTA":
                            allow_buy = False
                            micro_tag = f"BEAR_DELTA({delta_pct:+.1f}%)"

                k_buf, k_sl, k_tp = 1.1, 1.1, 2.8
                buf_dist = max(cur_atr * k_buf, info.spread * info.point * 2.0)
                sl_dist = cur_atr * k_sl
                tp_dist = cur_atr * k_tp
                lot = max(info.volume_min * 2.0, 0.02) if info.volume_min <= 0.01 else info.volume_min

                armed_legs = []
                if allow_buy:
                    buy_stop = round(tick.ask + buf_dist, info.digits)
                    req_buy = {
                        "action": mt5.TRADE_ACTION_PENDING,
                        "symbol": sym,
                        "volume": lot,
                        "type": mt5.ORDER_TYPE_BUY_STOP,
                        "price": buy_stop,
                        "sl": round(buy_stop - sl_dist, info.digits),
                        "tp": round(buy_stop + tp_dist, info.digits),
                        "type_time": mt5.ORDER_TIME_SPECIFIED,
                        "expiration": int(time.time()) + 3600,
                        "type_filling": mt5.ORDER_FILLING_IOC,
                        "comment": "NEXUS_V3_MICRO",
                    }
                    res_b = mt5.order_send(req_buy)
                    if res_b and res_b.retcode == mt5.TRADE_RETCODE_DONE:
                        armed_legs.append(f"BuyStop: {buy_stop:.{info.digits}f} (#{res_b.order})")

                if allow_sell:
                    sell_stop = round(tick.bid - buf_dist, info.digits)
                    req_sell = {
                        "action": mt5.TRADE_ACTION_PENDING,
                        "symbol": sym,
                        "volume": lot,
                        "type": mt5.ORDER_TYPE_SELL_STOP,
                        "price": sell_stop,
                        "sl": round(sell_stop + sl_dist, info.digits),
                        "tp": round(sell_stop - tp_dist, info.digits),
                        "type_time": mt5.ORDER_TIME_SPECIFIED,
                        "expiration": int(time.time()) + 3600,
                        "type_filling": mt5.ORDER_FILLING_IOC,
                        "comment": "NEXUS_V3_MICRO",
                    }
                    res_s = mt5.order_send(req_sell)
                    if res_s and res_s.retcode == mt5.TRADE_RETCODE_DONE:
                        armed_legs.append(f"SellStop: {sell_stop:.{info.digits}f} (#{res_s.order})")

                if armed_legs:
                    engaged_syms.add(sym)
                    logging.info(
                        f"[V3 ARMED | ML P={p_expansion:.2f} | {micro_tag} | ATR14={cur_atr:.2f}] "
                        f"{sym} ({lot}L) | {' | '.join(armed_legs)}"
                    )
            except Exception as e:
                logging.error(f"[CYCLE ERROR] {sym}: {e}", exc_info=True)

    def run(self):
        logging.info("[DAEMON ENGINE V3.0] Continuous loop engaged.")
        while True:
            self.cycle()
            time.sleep(POLL_INTERVAL)

if __name__ == "__main__":
    engine = DualGatedDynamicEngine()
    if len(sys.argv) > 1 and sys.argv[1] == "--dry-run-once":
        engine.cycle()
        logging.info("[DRY RUN COMPLETE] Cycle evaluated cleanly.")
    else:
        engine.run()