            elif data == "set_gate_75":
                S.gate = 75
                REFRESH_EVENT.set()
                ans = "Auto-Trigger Confidence Gate set to 75%."
            elif data == "set_gate_80":
                S.gate = 80
                REFRESH_EVENT.set()
                ans = "Auto-Trigger Confidence Gate set to 80%."
