    if s in INDICES: return "INDEX", s, None
    if len(s) >= 6 and s[-3:] in CCY:
        b, q = s[:-3], s[-3:]
        if b in CCY: return "FX", b, q
        if b in METALS: return "METAL", b, q
        if b in ENERGY: return "ENERGY", b, q
