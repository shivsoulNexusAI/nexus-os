def poll_fleet_cycle(force_digest: bool = False):
    ensure_core_daemon_alive()

    silo_reports = []
    total_balance = 0.0
    total_equity  = 0.0
    total_float   = 0.0
    total_open    = 0
    usd_cluster_exposure = 0
    health_warnings = []

    for silo in SILOS:
        ok = mt5.initialize(
            path=silo["path"],
            login=silo["login"],
            password=silo["password"],
            server=silo["server"],
        )
        if not ok:
            err = mt5.last_error()
            silo_reports.append(f"❌ {silo['id']} (#{silo['login']}): IPC OFFLINE {err}")
            health_warnings.append(f"{silo['id']} IPC Offline ({err})")
            continue

        acc = mt5.account_info()
        term = mt5.terminal_info()
        positions = mt5.positions_get() or []
        orders = mt5.orders_get() or []

        if acc and term:
            total_balance += acc.balance
            total_equity  += acc.equity
            total_float   += acc.profit
            total_open    += len(positions)

            ping_ms = round(term.ping_last / 1000.0, 1) if term.ping_last else 0.0
            algo_flag = "🟢" if term.trade_allowed else "🔴"
            conn_flag = "🌐" if term.connected else "⚠️"

            if not term.trade_allowed:
                health_warnings.append(f"{silo['id']} AlgoTrading OFF")
            if not term.connected:
                health_warnings.append(f"{silo['id']} Broker Disconnected")
            if ping_ms > FLEET_CONFIG["max_ping_ms"]:
                health_warnings.append(f"{silo['id']} High Latency ({ping_ms}ms)")

            for p in positions:
                if any(ccy in p.symbol for ccy in ("EUR", "GBP", "JPY", "XAU")):
                    usd_cluster_exposure += 1

            silo_reports.append(
                f"{algo_flag}{conn_flag} {silo['id']} #{acc.login} | Eq: ${acc.equity:,.2f} ({acc.profit:+.2f}) | "
                f"Pos: {len(positions)} | Ord: {len(orders)} | {ping_ms}ms"
            )
        mt5.shutdown()

    if total_equity > 0 and FLEET_CONFIG["fleet_start_equity"] is None:
        FLEET_CONFIG["fleet_start_equity"] = total_equity

    fleet_dd_pct = 0.0
    if FLEET_CONFIG["fleet_start_equity"]:
        fleet_dd_pct = max(
            0.0,
            ((FLEET_CONFIG["fleet_start_equity"] - total_equity) / FLEET_CONFIG["fleet_start_equity"]) * 100.0,
        )

    # Enforce Global 4.0% Portfolio Drawdown Hard Stop
    if fleet_dd_pct >= FLEET_CONFIG["max_fleet_drawdown_pct"] and total_open > 0:
        emergency_fleet_flatten(f"Fleet DD {fleet_dd_pct:.2f}% >= {FLEET_CONFIG['max_fleet_drawdown_pct']}%")

    # Alert Dev Guard immediately if any terminal silo loses AlgoTrading or connection
    if health_warnings:
        warn_msg = (
            f"⚠️ DEV GUARD HEALTH ALERT\n"
            f"Issues: {' | '.join(health_warnings)}\n"
            f"Time: {datetime.now(timezone.utc).strftime('%H:%M:%S UTC')}"
        )
        send_bot_msg("telegram_quantower_config.json", warn_msg, alert_key="dev_health", cooldown_sec=300)

    # Send consolidated Tripartite Fleet Attribution Digest every 30 minutes
    if force_digest or (time.time() - FLEET_CONFIG["last_digest_ts"]) >= (FLEET_CONFIG["digest_interval_mins"] * 60):
        now_utc = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
        digest = (
            f"🚢 QUANTNEXUS TRIPARTITE FLEET TELEMETRY (v4.0)\n"
            f"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
            f"Combined NAV   : ${total_balance:,.2f}\n"
            f"Combined Equity: ${total_equity:,.2f} ({total_float:+.2f})\n"
            f"Global Fleet DD: {fleet_dd_pct:.2f}% / {FLEET_CONFIG['max_fleet_drawdown_pct']}%\n"
            f"Active Exposure: {total_open} Open | Macro Cluster: {usd_cluster_exposure}/{FLEET_CONFIG['max_correlated_positions']}\n"
            f"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
            + "\n".join(silo_reports) + "\n"
            f"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
            f"🛡️ Dev Guard Watchdog: ARMED | {now_utc}"
        )
        send_bot_msg("telegram_nexus_config.json", digest)
        FLEET_CONFIG["last_digest_ts"] = time.time()

