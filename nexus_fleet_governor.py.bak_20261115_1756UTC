def ensure_core_daemon_alive():
    """Verifies nexus_ship_core.py is running; auto-triggers Task Scheduler if missing."""
    try:
        out = subprocess.check_output(
            'wmic process where "name=\'pythonw.exe\'" get CommandLine',
            shell=True,
        ).decode(errors="ignore")
        if "nexus_ship_core.py" not in out:
            subprocess.run(["schtasks", "/Run", "/TN", "QuantNexus_Unified_Ship_Core"], check=False)
            send_bot_msg(
                "telegram_quantower_config.json",
                "🛠️ DEV GUARD RECOVERY: nexus_ship_core.py was offline — automatically restarted via Task Scheduler.",
                alert_key="core_restart",
                cooldown_sec=120,
            )
    except Exception as e:
        print(f"[WATCHDOG ERR] {e}")

def emergency_fleet_flatten(reason: str):
    """Flattens all open positions across T1, T2, and T3 if global fleet drawdown breaches 4.0%."""
    total_closed = 0
    for silo in SILOS:
        if not mt5.initialize(path=silo["path"]):
            continue
        positions = mt5.positions_get() or []
        for p in positions:
            tick = mt5.symbol_info_tick(p.symbol)
            info = mt5.symbol_info(p.symbol)
            if not tick or not info:
                continue
            close_type = mt5.ORDER_TYPE_SELL if p.type == mt5.POSITION_TYPE_BUY else mt5.ORDER_TYPE_BUY
            price = tick.bid if close_type == mt5.ORDER_TYPE_SELL else tick.ask
            fill_mode = mt5.ORDER_FILLING_IOC if (info.filling_mode & 2) else mt5.ORDER_FILLING_FOK
            res = mt5.order_send({
                "action": mt5.TRADE_ACTION_DEAL,
                "symbol": p.symbol,
                "volume": p.volume,
                "type": close_type,
                "position": p.ticket,
                "price": price,
                "deviation": 35,
                "magic": p.magic,
                "comment": "FLEET CIRCUIT BREAKER",
                "type_time": mt5.ORDER_TIME_GTC,
                "type_filling": fill_mode,
            })
            if res and res.retcode == mt5.TRADE_RETCODE_DONE:
                total_closed += 1
        mt5.shutdown()

    alert = (
        f"🚨 GLOBAL FLEET CIRCUIT BREAKER TRIGGERED 🚨\n"
        f"Reason: {reason}\n"
        f"Action: Flattened {total_closed} open positions across T1/T2/T3."
    )
    send_bot_msg("t1_telegram_config.json", alert, alert_key="fleet_breaker", cooldown_sec=600)
    send_bot_msg("telegram_quantower_config.json", alert, alert_key="fleet_breaker_dev", cooldown_sec=600)

