def load_bot_creds(filename: str, fallback_file: str = "t1_telegram_config.json") -> tuple[str, str]:
    target = BASE_DIR / filename
    if not target.exists():
        target = BASE_DIR / fallback_file
    if not target.exists():
        return "", ""
    data = json.loads(target.read_text(encoding="utf-8-sig"))
    token = data.get("token", data.get("bot_token", data.get("", "")))
    chat_id = str(data.get("chat_id", data.get("authorized_chat_id", "5279761713")))
    return token, chat_id

def send_bot_msg(bot_file: str, text: str, alert_key: str = "", cooldown_sec: int = 300):
    if alert_key:
        last_t = FLEET_CONFIG["alert_cooldown"].get(alert_key, 0.0)
        if (time.time() - last_t) < cooldown_sec:
            return
        FLEET_CONFIG["alert_cooldown"][alert_key] = time.time()

    token, chat_id = load_bot_creds(bot_file)
    if not token or not chat_id:
        return
    try:
        httpx.post(
            f"https://api.telegram.org/bot{token}/sendMessage",
            json={"chat_id": chat_id, "text": text},
            timeout=10.0,
        )
    except Exception as e:
        print(f"[TG ERR {bot_file}] {e}")

