import sys
import json
import time
import logging
from datetime import datetime, timezone, timedelta
from pathlib import Path
import numpy as np
import pandas as pd
import MetaTrader5 as mt5
from telegram_notifier_v43 import send_v43_alert

sys.path.insert(0, r"C:\Quant-Nexus-OS")
try:
    from core.anti_whipsaw import AntiWhipsawEngine
except Exception:
    AntiWhipsawEngine = None

TERMINAL_PATH = r"C:/MT5_Quant_278017866/terminal64.exe"
MICRO_STATE_PATH = Path(r"C:\Quant-Nexus-Eng\microstructure_state.json")
LOG_PATH = Path(r"C:\Quant-Nexus-Eng\nexus_multi_straddle.log")

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    handlers=[logging.FileHandler(LOG_PATH, encoding="utf-8"), logging.StreamHandler(sys.stdout)],
)

CORE_TRIAD = ["XAUUSD", "US30", "BTCUSD"]
COMPRESSION_MULT = {"XAUUSD": 3.4, "US30": 2.6, "BTCUSD": 2.6}
RISK_PER_TRADE_PCT = 0.013  # 1.3% volatility parity sizing (~$15 risk per setup)
MAX_ACTIVE_ASSETS = 3
MAGIC_NUMBER = 20260430

class QuantNexusV43Daemon:
    def __init__(self):
        self.whipsaw = AntiWhipsawEngine(cooldown_sec=900, max_consecutive_losses=2, penalty_sec=3600) if AntiWhipsawEngine else None
        self.processed_deals = set()
        self.daily_box_cache = {}
        self.daily_traded = set()

    def connect_mt5(self) -> bool:
        if mt5.initialize(path=TERMINAL_PATH, portable=False):
            return True
        logging.error(f"MT5 initialize failed: {mt5.last_error()}")
        return False

    def read_microstructure(self, sym: str) -> dict:
        try:
            if MICRO_STATE_PATH.exists():
                data = json.loads(MICRO_STATE_PATH.read_text(encoding="utf-8"))
                fleet = data.get("fleet") or data.get("symbols") or data
                st = fleet.get(sym, {}) if isinstance(fleet, dict) else {}
                if isinstance(st, dict):
                    return {
                        "delta_pct": float(st.get("delta_pct", 0.0)),
                        "inside_poc_chop": bool(st.get("inside_poc_chop", False)),
                        "vpoc": float(st.get("vpoc", 0.0)),
                        "vah": float(st.get("vah", 0.0)),
                        "val": float(st.get("val", 0.0)),
                        "regime": str(st.get("regime", "UNKNOWN")),
                    }
        except Exception:
            pass
        return {}

    def sync_whipsaw_history(self):
        if not self.whipsaw:
            return
        ref_tick = mt5.symbol_info_tick("EURUSD")
        now_ts = int(ref_tick.time) if ref_tick else int(time.time())
        now_dt = datetime.fromtimestamp(now_ts, tz=timezone.utc)
        deals = mt5.history_deals_get(now_dt - timedelta(hours=3), now_dt + timedelta(hours=3)) or []
        for d in sorted(deals, key=lambda x: x.time):
            if d.entry == 1 and d.ticket not in self.processed_deals:
                self.processed_deals.add(d.ticket)
                if d.symbol in CORE_TRIAD and 0 <= (now_ts - d.time) <= 3600:
                    if d.profit < -0.10:
                        self.whipsaw.record_loss(d.symbol)
                    elif d.profit > 0.10:
                        self.whipsaw.record_win(d.symbol)

    def enforce_per_symbol_oco(self, positions, orders):
        active_syms = {p.symbol for p in positions}
        for o in orders:
            if o.symbol in active_syms:
                res = mt5.order_send({"action": mt5.TRADE_ACTION_REMOVE, "order": o.ticket})
                if res and res.retcode == mt5.TRADE_RETCODE_DONE:
                    logging.info(f"[V4.3 OCO] Cancelled opposite pending leg #{o.ticket} on {o.symbol}.")

    def get_h1_strong_bull(self, sym: str) -> bool:
        rates = mt5.copy_rates_from_pos(sym, mt5.TIMEFRAME_H1, 1, 60)
        if rates is None or len(rates) < 50:
            return False
        closes = pd.Series([float(r["close"]) for r in rates])
        ema20 = closes.ewm(span=20, adjust=False).mean().iloc[-1]
        ema50 = closes.ewm(span=50, adjust=False).mean().iloc[-1]
        return bool(closes.iloc[-1] > ema20 and ema20 > ema50)

    def compute_coiled_session_box(self, sym: str, srv_dt: datetime):
        date_str = srv_dt.strftime("%Y-%m-%d")
        key = (date_str, sym)
        if key in self.daily_box_cache:
            return self.daily_box_cache[key]

        if srv_dt.hour < 4:
            return None

        rates = mt5.copy_rates_from_pos(sym, mt5.TIMEFRAME_M15, 1, 80)
        if rates is None or len(rates) < 60:
            return None

        df = pd.DataFrame(rates)
        df["dt"] = pd.to_datetime(df["time"], unit="s", utc=True)

        prev_c = df["close"].shift(1)
        tr = np.maximum(df["high"] - df["low"], np.maximum((df["high"] - prev_c).abs(), (df["low"] - prev_c).abs()))
        df["atr20"] = tr.rolling(20).mean()
        df["atr56"] = tr.rolling(56).mean()

        today_bars = df[df["dt"].dt.strftime("%Y-%m-%d") == date_str]
        if len(today_bars) < 16:
            return None

        ref = today_bars.iloc[:16]
        ref_high = float(ref["high"].max())
        ref_low = float(ref["low"].min())
        atr_box = float(ref["atr20"].iloc[-1])
        atr_56 = float(ref["atr56"].iloc[-1])
        if np.isnan(atr_box) or np.isnan(atr_56) or atr_box <= 0 or atr_56 <= 0:
            return None

        box_range = ref_high - ref_low
        max_mult = COMPRESSION_MULT.get(sym, 2.6)
        if box_range > (atr_56 * max_mult) or box_range < (atr_box * 0.6):
            self.daily_box_cache[key] = None
            logging.info(f"[V4.3 SKIP NON-COILED] {sym} Asian box={box_range:.2f} vs {max_mult}x ATR56={atr_56 * max_mult:.2f}")
            return None

        buf_dist = atr_box * 0.40
        sl_dist = atr_box * 1.25
        box = {
            "ref_high": ref_high,
            "ref_low": ref_low,
            "atr_box": atr_box,
            "buy_stop": ref_high + buf_dist,
            "sell_stop": ref_low - buf_dist,
            "sl_dist": sl_dist,
        }
        self.daily_box_cache[key] = box
        logging.info(f"[V4.3 COILED BOX LOCKED] {sym} Range=[{ref_low:.2f}..{ref_high:.2f}] | BuyStop={box['buy_stop']:.2f} | SellStop={box['sell_stop']:.2f}")
        return box

    def calc_volatility_parity_lot(self, info, equity: float, sl_dist: float) -> float:
        usd_per_unit = (info.trade_tick_value / info.trade_tick_size) if info.trade_tick_size > 0 else info.trade_contract_size
        risk_usd = max(10.0, equity * RISK_PER_TRADE_PCT)
        raw_lot = risk_usd / max(sl_dist * usd_per_unit, 1e-6)
        step = info.volume_step if info.volume_step > 0 else 0.01
        lot = round(raw_lot / step) * step
        return round(max(info.volume_min, min(0.25, lot)), 2)

    def close_eod_runners(self, positions, srv_dt: datetime):
        if srv_dt.hour == 22 and srv_dt.minute >= 45:
            for p in positions:
                if p.magic == MAGIC_NUMBER:
                    tick = mt5.symbol_info_tick(p.symbol)
                    if not tick:
                        continue
                    is_buy = (p.type == mt5.POSITION_TYPE_BUY)
                    res = mt5.order_send({
                        "action": mt5.TRADE_ACTION_DEAL,
                        "position": p.ticket,
                        "symbol": p.symbol,
                        "volume": p.volume,
                        "type": mt5.ORDER_TYPE_SELL if is_buy else mt5.ORDER_TYPE_BUY,
                        "price": tick.bid if is_buy else tick.ask,
                        "deviation": 30,
                        "type_filling": mt5.ORDER_FILLING_IOC,
                        "comment": "NEXUS_V43_EOD_SESSION_CLOSE",
                    })
                    if res and res.retcode == mt5.TRADE_RETCODE_DONE:
                        logging.info(f"[V4.3 EOD CLOSE] Closed surviving session runner {p.symbol} #{p.ticket} PnL=${p.profit:+.2f}")
                        send_v43_alert(
                            f"🏁 <b>[V4.3 EOD RUNNER CLOSE]</b>\n"
                            f"Asset: <b>{p.symbol}</b> (#{p.ticket})\n"
                            f"Volume: {p.volume}L | Realized PnL: <b>${p.profit:+.2f}</b>"
                        )

    def cycle(self):
        acc = mt5.account_info()
        if not acc:
            return

        positions = mt5.positions_get() or []
        orders = mt5.orders_get() or []

        ref_tick = mt5.symbol_info_tick("XAUUSD")
        srv_dt = datetime.fromtimestamp(ref_tick.time, tz=timezone.utc) if ref_tick else datetime.now(timezone.utc)

        self.sync_whipsaw_history()
        self.enforce_per_symbol_oco(positions, orders)
        self.close_eod_runners(positions, srv_dt)

        engaged_syms = {p.symbol for p in positions} | {o.symbol for o in orders}
        if len(engaged_syms) >= MAX_ACTIVE_ASSETS:
            return

        if (srv_dt.hour == 13 and 15 <= srv_dt.minute <= 45) or srv_dt.hour >= 17 or srv_dt.hour < 4:
            return

        date_str = srv_dt.strftime("%Y-%m-%d")

        for sym in CORE_TRIAD:
            if len(engaged_syms) >= MAX_ACTIVE_ASSETS:
                break
            if sym in engaged_syms or (date_str, sym) in self.daily_traded:
                continue
            if self.whipsaw:
                allowed = True
                for fn_name in ("is_allowed", "allow_trade", "can_trade", "check"):
                    fn = getattr(self.whipsaw, fn_name, None)
                    if callable(fn):
                        res_w = fn(sym)
                        allowed = res_w[0] if isinstance(res_w, tuple) else bool(res_w)
                        break
                if not allowed:
                    continue

            mt5.symbol_select(sym, True)
            info = mt5.symbol_info(sym)
            tick = mt5.symbol_info_tick(sym)
            if not info or not tick:
                continue

            box = self.compute_coiled_session_box(sym, srv_dt)
            if not box:
                continue

            micro = self.read_microstructure(sym)
            delta_pct = float(micro.get("delta_pct", 0.0))
            inside_chop = bool(micro.get("inside_poc_chop", False))
            if inside_chop:
                continue

            sl_dist = box["sl_dist"]
            lot = self.calc_volatility_parity_lot(info, acc.equity, sl_dist)
            exp_time = int(time.time()) + 3600

            # 1. Coiled Bearish Breakdown (resting SELL_STOP when delta is not heavily bullish)
            if delta_pct < 20.0 and tick.bid < box["sell_stop"]:
                sl_sell = round(box["sell_stop"] + sl_dist, info.digits)
                res = mt5.order_send({
                    "action": mt5.TRADE_ACTION_PENDING,
                    "symbol": sym,
                    "volume": lot,
                    "type": mt5.ORDER_TYPE_SELL_STOP,
                    "price": round(box["sell_stop"], info.digits),
                    "sl": sl_sell,
                    "deviation": 30,
                    "magic": MAGIC_NUMBER,
                    "type_time": mt5.ORDER_TIME_SPECIFIED,
                    "expiration": exp_time,
                    "type_filling": mt5.ORDER_FILLING_IOC,
                    "comment": "NEXUS_V43_COILED_SELL",
                })
                if res and res.retcode == mt5.TRADE_RETCODE_DONE:
                    engaged_syms.add(sym)
                    self.daily_traded.add((date_str, sym))
                    logging.info(f"[V4.3 COILED SELL ARMED] {sym} {lot}L SELL_STOP @ {round(box['sell_stop'], info.digits)} | SL={sl_sell} | Delta={delta_pct:+.1f}% (#{res.order})")
                    send_v43_alert(
                        f"🔻 <b>[V4.3 COILED SELL ARMED]</b>\n"
                        f"Asset: <b>{sym}</b> ({lot}L) | Ticket: #{res.order}\n"
                        f"Entry Stop: <code>{round(box['sell_stop'], info.digits)}</code> | SL: <code>{sl_sell}</code>\n"
                        f"Box Low: <code>{round(box['ref_low'], info.digits)}</code> | Delta: <b>{delta_pct:+.1f}%</b>"
                    )
                    continue

            # 2. Coiled Bullish Breakout (resting BUY_STOP ONLY when H1 EMA20>EMA50 AND Delta >= +25%)
            if self.get_h1_strong_bull(sym) and delta_pct >= 25.0 and tick.ask < box["buy_stop"]:
                sl_buy = round(box["buy_stop"] - sl_dist, info.digits)
                res = mt5.order_send({
                    "action": mt5.TRADE_ACTION_PENDING,
                    "symbol": sym,
                    "volume": lot,
                    "type": mt5.ORDER_TYPE_BUY_STOP,
                    "price": round(box["buy_stop"], info.digits),
                    "sl": sl_buy,
                    "deviation": 30,
                    "magic": MAGIC_NUMBER,
                    "type_time": mt5.ORDER_TIME_SPECIFIED,
                    "expiration": exp_time,
                    "type_filling": mt5.ORDER_FILLING_IOC,
                    "comment": "NEXUS_V43_COILED_BUY",
                })
                if res and res.retcode == mt5.TRADE_RETCODE_DONE:
                    engaged_syms.add(sym)
                    self.daily_traded.add((date_str, sym))
                    logging.info(f"[V4.3 COILED BUY ARMED] {sym} {lot}L BUY_STOP @ {round(box['buy_stop'], info.digits)} | SL={sl_buy} | H1_BULL=True | Delta={delta_pct:+.1f}% (#{res.order})")
                    send_v43_alert(
                        f"🚀 <b>[V4.3 COILED BUY ARMED]</b>\n"
                        f"Asset: <b>{sym}</b> ({lot}L) | Ticket: #{res.order}\n"
                        f"Entry Stop: <code>{round(box['buy_stop'], info.digits)}</code> | SL: <code>{sl_buy}</code>\n"
                        f"H1 Trend: <b>BULLISH</b> | Delta: <b>{delta_pct:+.1f}%</b>"
                    )

    def run(self):
        if not self.connect_mt5():
            sys.exit(1)
        logging.info("=" * 92)
        logging.info("NEXUS ENGINE V4.3 FINAL PRODUCTION ONLINE (COILED COMPRESSION | UNCAPPED SESSION RUNNER | 1.88+ PF)")
        logging.info("=" * 92)
        while True:
            try:
                self.cycle()
            except Exception as e:
                logging.error(f"Cycle exception: {e}")
            time.sleep(30)

if __name__ == "__main__":
    QuantNexusV43Daemon().run()