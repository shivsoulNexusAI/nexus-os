def tg_send(text: str, with_keyboard: bool = False):
    token, chat_id = load_tg()
    if not token:
        return
    payload = {"chat_id": chat_id, "text": text}
    if with_keyboard:
        payload["reply_markup"] = {
            "keyboard": [
                [{"text": "/status"}, {"text": "/scan"}],
                [{"text": "/gate 80"}, {"text": "/gate 82"}, {"text": "/flatten"}]
            ],
            "resize_keyboard": True
        }
    try:
        httpx.post(f"https://api.telegram.org/bot{token}/sendMessage", json=payload, timeout=10.0)
    except Exception as e:
        print(f"[TG SEND ERR] {e}")

def flatten_all_sleeves() -> str:
    closed_tot, canc_tot = 0, 0
    for s_id, cfg in SLEEVES.items():
        if not mt5.initialize(path=cfg["path"], login=cfg["login"], password=cfg["password"], server=cfg["server"]):
            continue
        for o in (mt5.orders_get() or []):
            r = mt5.order_send({"action": mt5.TRADE_ACTION_REMOVE, "order": o.ticket})
            if r and r.retcode == mt5.TRADE_RETCODE_DONE:
                canc_tot += 1
        for p in (mt5.positions_get() or []):
            tick = mt5.symbol_info_tick(p.symbol)
            info = mt5.symbol_info(p.symbol)
            if not tick or not info:
                continue
            c_type = mt5.ORDER_TYPE_SELL if p.type == mt5.POSITION_TYPE_BUY else mt5.ORDER_TYPE_BUY
            price = tick.bid if c_type == mt5.ORDER_TYPE_SELL else tick.ask
            fill_mode = mt5.ORDER_FILLING_IOC if (info.filling_mode & 2) else mt5.ORDER_FILLING_FOK
            res = mt5.order_send({
                "action": mt5.TRADE_ACTION_DEAL,
                "symbol": p.symbol,
                "volume": p.volume,
                "type": c_type,
                "position": p.ticket,
                "price": price,
                "deviation": 30,
                "magic": p.magic,
                "comment": "NEXUS FLEET FLATTEN",
                "type_time": mt5.ORDER_TIME_GTC,
                "type_filling": fill_mode,
            })
            if res and res.retcode == mt5.TRADE_RETCODE_DONE:
                closed_tot += 1
        mt5.shutdown()
    return f"🚨 TRIPARTITE FLATTEN COMPLETE: Closed {closed_tot} positions & cancelled {canc_tot} limits across T1/T2/T3."

def telegram_command_worker():
    token, auth_chat = load_tg()
    while STATE["running"]:
        try:
            resp = httpx.get(
                f"https://api.telegram.org/bot{token}/getUpdates",
                params={"offset": STATE["last_update_id"] + 1, "timeout": 15},
                timeout=20.0
            ).json()
            for upd in resp.get("result", []):
                STATE["last_update_id"] = upd["update_id"]
                msg = upd.get("message", {})
                if str(msg.get("chat", {}).get("id")) != auth_chat:
                    continue
                cmd = msg.get("text", "").strip().lower()
                if cmd in ("/status", "/scan"):
                    run_nexus_cycle(force_broadcast=True)
                elif cmd.startswith("/gate"):
                    parts = cmd.split()
                    if len(parts) == 2 and parts[1].isdigit():
                        val = float(parts[1])
                        STATE["confidence_gate"] = val
                        STATE["sleeve_gates"]["T1"] = val
                        STATE["sleeve_gates"]["T2"] = val
                        tg_send(f"🎯 Base Gate (T1/T2) updated to >= {int(val)}% (T3: >= {int(STATE['sleeve_gates']['T3'])}%)", with_keyboard=True)
                    elif len(parts) == 3 and parts[1].upper() in STATE["sleeve_gates"] and parts[2].isdigit():
                        s_key = parts[1].upper()
                        val = float(parts[2])
                        STATE["sleeve_gates"][s_key] = val
                        tg_send(f"🎯 Sleeve {s_key} Gate updated to >= {int(val)}%", with_keyboard=True)
                elif cmd == "/flatten":
                    tg_send(flatten_all_sleeves(), with_keyboard=True)
        except Exception:
            time.sleep(3)

