def register_tranche(ticket: int, sleeve: str, initial_sl_dist: float):
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("INSERT OR REPLACE INTO tranche_state (ticket, sleeve, initial_sl_dist, banked_partial) VALUES (?, ?, ?, 0)", (ticket, sleeve, initial_sl_dist))
    conn.commit()
    conn.close()

def get_tranche_info(ticket: int) -> tuple[float, bool]:
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("SELECT initial_sl_dist, banked_partial FROM tranche_state WHERE ticket = ?", (ticket,))
    row = cur.fetchone()
    conn.close()
    return (float(row[0]), bool(row[1])) if row else (0.0, False)

def mark_tranche_banked(ticket: int):
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("UPDATE tranche_state SET banked_partial = 1 WHERE ticket = ?", (ticket,))
    conn.commit()
    conn.close()

