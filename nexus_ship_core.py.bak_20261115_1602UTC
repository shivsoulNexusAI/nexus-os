def compute_half_kelly_lots(symbol: str, sl_distance_price: float, equity: float, magic: int) -> tuple[float, float]:
    info = mt5.symbol_info(symbol)
    if not info or sl_distance_price <= 0:
        return 0.02, 0.005

    from_ts = datetime(2026, 1, 1, tzinfo=timezone.utc)
    deals = mt5.history_deals_get(from_ts, datetime.now(timezone.utc)) or []
    closed_pnls = [d.profit for d in deals if d.magic == magic and d.entry == mt5.DEAL_ENTRY_OUT and d.profit != 0]

    if len(closed_pnls) >= 15:
        wins = [p for p in closed_pnls[-50:] if p > 0]
        losses = [abs(p) for p in closed_pnls[-50:] if p < 0]
        p = len(wins) / max(1, len(wins) + len(losses))
        avg_win = np.mean(wins) if wins else 1.0
        avg_loss = np.mean(losses) if losses else 1.0
        b = avg_win / max(0.01, avg_loss)
        full_kelly = p - ((1.0 - p) / max(0.1, b))
        half_kelly = max(0.0025, min(STATE["max_risk_per_trade_pct"] / 100.0, full_kelly * 0.5))
    else:
        half_kelly = 0.005

    risk_dollars = equity * half_kelly
    tick_val = info.trade_tick_value if info.trade_tick_value > 0 else 1.0
    tick_size = info.trade_tick_size if info.trade_tick_size > 0 else info.point
    ticks_at_risk = sl_distance_price / tick_size
    raw_lots = risk_dollars / max(1.0, ticks_at_risk * tick_val)

    step = info.volume_step if info.volume_step > 0 else 0.01
    min_tranche_lot = max(info.volume_min * 2.0, 0.02)
    lots = round(max(min_tranche_lot, min(info.volume_max, round(raw_lots / step) * step)), 2)
    return lots, half_kelly

def compute_true_tick_orderflow(symbol: str, lookback_mins: int = 30) -> tuple[float, float]:
    utc_to = datetime.now(timezone.utc)
    utc_from = utc_to - timedelta(minutes=lookback_mins)
    ticks = mt5.copy_ticks_from(symbol, utc_from, 2500, mt5.COPY_TICKS_ALL)
    if ticks is None or len(ticks) < 40:
        return 0.0, 0.0

    bids, asks, lasts = ticks['bid'], ticks['ask'], ticks['last']
    vols = np.where(ticks['volume'] > 0, ticks['volume'], 1.0).astype(float)
    flags = ticks['flags']

    buy_vol, sell_vol = 0.0, 0.0
    bucket_imbalances, bucket_vols = [], []
    cur_b_buy, cur_b_sell = 0.0, 0.0
    bucket_size = max(10.0, np.sum(vols) / 12.0)

    for i in range(1, len(ticks)):
        f, v = flags[i], vols[i]
        is_buy = bool(f & mt5.TICK_FLAG_BUY)
        is_sell = bool(f & mt5.TICK_FLAG_SELL)
        if not is_buy and not is_sell:
            mid_now = (bids[i] + asks[i]) * 0.5
            mid_prev = (bids[i - 1] + asks[i - 1]) * 0.5
            if mid_now > mid_prev or (lasts[i] > 0 and lasts[i] >= asks[i]):
                is_buy = True
            elif mid_now < mid_prev or (lasts[i] > 0 and lasts[i] <= bids[i]):
                is_sell = True

        if is_buy:
            buy_vol += v
            cur_b_buy += v
        elif is_sell:
            sell_vol += v
            cur_b_sell += v

        if (cur_b_buy + cur_b_sell) >= bucket_size:
            bucket_imbalances.append(abs(cur_b_buy - cur_b_sell))
            bucket_vols.append(cur_b_buy + cur_b_sell)
            cur_b_buy, cur_b_sell = 0.0, 0.0

    tot_vol = max(1.0, buy_vol + sell_vol)
    tick_imb = (buy_vol - sell_vol) / tot_vol
    true_vpin = float(np.sum(bucket_imbalances) / max(1.0, np.sum(bucket_vols))) if bucket_vols else abs(tick_imb)
    return min(0.99, true_vpin), max(-0.99, min(0.99, tick_imb))

def detect_ict_fvg_midpoint(highs: np.ndarray, lows: np.ndarray, direction: str) -> float:
    if direction == "BUY":
        for idx in range(len(highs) - 2, max(2, len(highs) - 7), -1):
            if lows[idx] > highs[idx - 2]:
                return float((lows[idx] + highs[idx - 2]) * 0.5)
    elif direction == "SELL":
        for idx in range(len(lows) - 2, max(2, len(lows) - 7), -1):
            if highs[idx] < lows[idx - 2]:
                return float((highs[idx] + lows[idx - 2]) * 0.5)
    return 0.0

def evaluate_alpha_matrix(symbol: str) -> dict:
    rates_m15 = mt5.copy_rates_from_pos(symbol, mt5.TIMEFRAME_M15, 0, 65)
    rates_m5  = mt5.copy_rates_from_pos(symbol, mt5.TIMEFRAME_M5, 0, 24)
    info = mt5.symbol_info(symbol)
    tick = mt5.symbol_info_tick(symbol)

    if rates_m15 is None or rates_m5 is None or not info or not tick or len(rates_m15) < 60 or len(rates_m5) < 15:
        return {"symbol": symbol, "dir": "FLAT", "tf": "M15", "conf": 50, "delta": 0, "dii": 0.0, "vpin": 0.0, "ict": "NO_DATA", "atr": 0.0, "fvg_mid": 0.0}

    closes = np.array([r['close'] for r in rates_m5], dtype=float)
    highs  = np.array([r['high'] for r in rates_m5], dtype=float)
    lows   = np.array([r['low'] for r in rates_m5], dtype=float)
    opens  = np.array([r['open'] for r in rates_m5], dtype=float)
    vols   = np.array([r['tick_volume'] for r in rates_m5], dtype=float)

    tr = np.maximum(highs[1:] - lows[1:], np.maximum(np.abs(highs[1:] - closes[:-1]), np.abs(lows[1:] - closes[:-1])))
    atr = float(np.mean(tr[-14:]))
    live_spread = max(0.0, tick.ask - tick.bid)
    spread_to_atr = live_spread / max(info.point, atr)

    m15_closes_full = np.array([r['close'] for r in rates_m15], dtype=float)
    m15_vols_full   = np.array([r['tick_volume'] for r in rates_m15], dtype=float)
    win_c = m15_closes_full[-32:]
    win_v = m15_vols_full[-32:]
    poc = float(win_c[np.argmax(win_v)])
    val = float(np.percentile(win_c, 25))
    vah = float(np.percentile(win_c, 75))
    curr_price = float(closes[-1])

    true_vpin, tick_imb = compute_true_tick_orderflow(symbol, lookback_mins=30)
    if true_vpin == 0.0:
        c_rng = np.maximum(highs - lows, info.point)
        b_est = vols * ((closes - lows) / c_rng)
        s_est = vols * ((highs - closes) / c_rng)
        true_vpin = float(np.sum(np.abs(b_est[-10:] - s_est[-10:])) / max(1.0, np.sum(vols[-10:])))
        tick_imb = float((b_est[-1] - s_est[-1]) / max(1.0, vols[-1]))

    ema21 = float(np.mean(m15_closes_full[-21:]))
    ema55 = float(np.mean(m15_closes_full[-55:]))
    div = 3.0 if info.digits == 5 else 10.0

    m15_move = (rates_m15[-1]['close'] - rates_m15[-3]['open']) / info.point
    m5_move  = (closes[-1] - opens[-2]) / info.point
    if abs(m5_move) > abs(m15_move) * 0.6:
        tf = "M5 "
        price_delta = int(round(m5_move / div))
    else:
        tf = "M15"
        price_delta = int(round(m15_move / div))

    dii = max(-0.99, min(0.99, (price_delta / 100.0) * (1.0 + true_vpin) * 0.6 + tick_imb * 0.5))

    prev_swing_low  = float(np.min(lows[-16:-2]))
    prev_swing_high = float(np.max(highs[-16:-2]))
    ict_tag = "NEUTRAL"
    ict_bonus = 0.0

    if lows[-2] < prev_swing_low and curr_price > prev_swing_low and curr_price <= poc and price_delta > 0:
        ict_tag = "SSL-SWEEP+DISC"
        ict_bonus = 14.0
    elif highs[-2] > prev_swing_high and curr_price < prev_swing_high and curr_price >= poc and price_delta < 0:
        ict_tag = "BSL-SWEEP+PREM"
        ict_bonus = 14.0
    elif curr_price <= val and price_delta > 0:
        ict_tag = "VAL-RECLAIM"
        ict_bonus = 9.0
    elif curr_price >= vah and price_delta < 0:
        ict_tag = "VAH-REJECT"
        ict_bonus = 9.0

    news_locked, news_label = check_macro_news_blackout(symbol)
    _, in_fx_kz, in_rollover = get_chronos_session()
    is_btc = "BTC" in symbol
    hr = datetime.now(timezone.utc).hour
    in_kz = (8 <= hr <= 21) if is_btc else (in_fx_kz and not in_rollover)
    spread_ok = spread_to_atr <= STATE["max_spread_atr_ratio"]
    regime_ok = (price_delta > 0 and ema21 > ema55) or (price_delta < 0 and ema21 < ema55)
    tick_aligned = (price_delta > 0 and tick_imb >= -0.05) or (price_delta < 0 and tick_imb <= 0.05)

    if news_locked:
        ict_tag = news_label
        conf = 50
    elif not spread_ok:
        ict_tag = f"SPR-SHIELD({spread_to_atr:.2f})"
        conf = 52
    elif not in_kz or not regime_ok or not tick_aligned or true_vpin < 0.52 or ict_bonus <= 0:
        conf = min(74, int(round(50.0 + min(20.0, abs(price_delta) * 0.15 + abs(dii) * 15.0))))
    else:
        base_score = 50.0 + min(26.0, abs(price_delta) * 0.20 + abs(dii) * 24.0) + (true_vpin * 12.0) + ict_bonus
        conf = int(round(min(98.0, base_score)))

    direction = ("BUY" if price_delta > 0 else "SELL") if (conf >= 60 and price_delta != 0) else "FLAT"
    fvg_mid = detect_ict_fvg_midpoint(highs, lows, direction) if direction in ("BUY", "SELL") else 0.0

    m15_h = np.array([r['high'] for r in rates_m15], dtype=float)
    m15_l = np.array([r['low'] for r in rates_m15], dtype=float)
    m15_tr = np.maximum(m15_h[1:] - m15_l[1:], np.maximum(np.abs(m15_h[1:] - m15_closes_full[:-1]), np.abs(m15_l[1:] - m15_closes_full[:-1])))
    atr_m15 = float(np.mean(m15_tr[-14:]))

    return {
        "symbol": symbol, "dir": direction, "tf": tf, "conf": conf,
        "delta": price_delta, "dii": dii, "vpin": true_vpin, "ict": ict_tag,
        "atr": atr, "atr_m15": atr_m15, "fvg_mid": fvg_mid
    }

