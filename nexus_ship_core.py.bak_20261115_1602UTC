        except Exception:
            pass
    if high_impact:
        NEWS_CACHE_PATH.write_text(json.dumps(high_impact, indent=2), encoding="utf-8")
        STATE["last_news_sync_ts"] = time.time()

def check_macro_news_blackout(symbol: str) -> tuple[bool, str]:
    if not NEWS_CACHE_PATH.exists():
        return False, ""
    try:
        events = json.loads(NEWS_CACHE_PATH.read_text(encoding="utf-8"))
        now_ts = time.time()
        ccys = SYMBOL_CURRENCIES.get(symbol, ["USD"])
        for ev in events:
            if ev.get("country") in ccys:
                diff_mins = (ev["ts_utc"] - now_ts) / 60.0
                if -10.0 <= diff_mins <= 15.0:
                    return True, f"NEWS-LOCK({ev['country']}:{ev['title'][:12]})"
    except Exception:
        pass
    return False, ""

def get_chronos_session() -> tuple[str, bool, bool]:
    now = datetime.now(timezone.utc)
    hr, mn = now.hour, now.minute
    in_rollover = (hr == 20 and mn >= 55) or (hr == 21) or (hr == 22 and mn <= 10)
    if 7 <= hr <= 10:
        return "🇬🇧 LDN KZ", True, in_rollover
    elif 12 <= hr <= 16:
        return "🇺🇸 NY-LDN OVLP", True, in_rollover
    elif 0 <= hr <= 3:
        return "🇯🇵 ASIA KZ", False, in_rollover
    return "🌐 OFF-PEAK", False, in_rollover

