def sync_macro_calendar():
    if (time.time() - STATE["last_news_sync_ts"]) < 21600 and NEWS_CACHE_PATH.exists():
        return
    feeds = [
        "https://nfs.faireconomy.media/ff_calendar_thisweek.json",
