def manage_sleeve_positions(sleeve_id: str, magic: int, atr_map: dict) -> list[str]:
    positions = mt5.positions_get(magic=magic) or []
    events = []

    for pos in positions:
        info = mt5.symbol_info(pos.symbol)
        tick = mt5.symbol_info_tick(pos.symbol)
        if not info or not tick:
            continue

        spread = tick.ask - tick.bid
        init_sl_dist, already_banked = get_tranche_info(pos.ticket)
        if init_sl_dist <= 0:
            init_sl_dist = abs(pos.price_open - pos.sl) if pos.sl > 0 else (atr_map.get(pos.symbol, 0.0) * 2.2)
            if init_sl_dist > 0:
                register_tranche(pos.ticket, sleeve_id, init_sl_dist)
        if init_sl_dist <= 0:
            continue

        news_locked, _ = check_macro_news_blackout(pos.symbol)
        atr = atr_map.get(pos.symbol, init_sl_dist * 0.45)
        trail_dist = max(spread * 2.0, atr * (1.0 if news_locked else 1.8))
        fill_mode = mt5.ORDER_FILLING_IOC if (info.filling_mode & 2) else mt5.ORDER_FILLING_FOK

        if pos.type == mt5.POSITION_TYPE_BUY:
            gain = tick.bid - pos.price_open
            be_level = round(pos.price_open + spread + 5 * info.point, info.digits)

            if not already_banked and gain >= 1.2 * init_sl_dist:
                half_vol = round(pos.volume * 0.5, 2)
                if half_vol >= info.volume_min and (pos.volume - half_vol) >= info.volume_min:
                    close_res = mt5.order_send({
                        "action": mt5.TRADE_ACTION_DEAL,
                        "symbol": pos.symbol,
                        "volume": half_vol,
                        "type": mt5.ORDER_TYPE_SELL,
                        "position": pos.ticket,
                        "price": tick.bid,
                        "deviation": 30,
                        "magic": magic,
                        "comment": f"{sleeve_id} +1.2R 50% BANK",
                        "type_time": mt5.ORDER_TIME_GTC,
                        "type_filling": fill_mode,
                    })
                    if close_res and close_res.retcode == mt5.TRADE_RETCODE_DONE:
                        mark_tranche_banked(pos.ticket)
                        already_banked = True
                        events.append(f"💰 [{sleeve_id}] +1.2R BANKED 50% {pos.symbol} ({half_vol}L)")

                if pos.sl < be_level:
                    sl_res = mt5.order_send({"action": mt5.TRADE_ACTION_SLTP, "symbol": pos.symbol, "position": pos.ticket, "sl": be_level, "tp": pos.tp})
                    if sl_res and sl_res.retcode == mt5.TRADE_RETCODE_DONE:
                        mark_tranche_banked(pos.ticket)
                        already_banked = True
                        events.append(f"🛡️ [{sleeve_id}] BE LOCKED {pos.symbol} @ {be_level}")

            elif (already_banked and gain >= 1.5 * init_sl_dist) or (news_locked and gain >= 0.6 * init_sl_dist):
                new_trail_sl = round(tick.bid - trail_dist, info.digits)
                if new_trail_sl > pos.sl + (10 * info.point) and new_trail_sl >= be_level:
                    tr_res = mt5.order_send({"action": mt5.TRADE_ACTION_SLTP, "symbol": pos.symbol, "position": pos.ticket, "sl": new_trail_sl, "tp": pos.tp})
                    if tr_res and tr_res.retcode == mt5.TRADE_RETCODE_DONE:
                        events.append(f"📈 [{sleeve_id}] ATR TRAIL {pos.symbol} SL->{new_trail_sl}")

        elif pos.type == mt5.POSITION_TYPE_SELL:
            gain = pos.price_open - tick.ask
            be_level = round(pos.price_open - spread - 5 * info.point, info.digits)

            if not already_banked and gain >= 1.2 * init_sl_dist:
                half_vol = round(pos.volume * 0.5, 2)
                if half_vol >= info.volume_min and (pos.volume - half_vol) >= info.volume_min:
                    close_res = mt5.order_send({
                        "action": mt5.TRADE_ACTION_DEAL,
                        "symbol": pos.symbol,
                        "volume": half_vol,
                        "type": mt5.ORDER_TYPE_BUY,
                        "position": pos.ticket,
                        "price": tick.ask,
                        "deviation": 30,
                        "magic": magic,
                        "comment": f"{sleeve_id} +1.2R 50% BANK",
                        "type_time": mt5.ORDER_TIME_GTC,
                        "type_filling": fill_mode,
                    })
                    if close_res and close_res.retcode == mt5.TRADE_RETCODE_DONE:
                        mark_tranche_banked(pos.ticket)
                        already_banked = True
                        events.append(f"💰 [{sleeve_id}] +1.2R BANKED 50% {pos.symbol} ({half_vol}L)")

                if pos.sl > be_level or pos.sl == 0.0:
                    sl_res = mt5.order_send({"action": mt5.TRADE_ACTION_SLTP, "symbol": pos.symbol, "position": pos.ticket, "sl": be_level, "tp": pos.tp})
                    if sl_res and sl_res.retcode == mt5.TRADE_RETCODE_DONE:
                        mark_tranche_banked(pos.ticket)
                        already_banked = True
                        events.append(f"🛡️ [{sleeve_id}] BE LOCKED {pos.symbol} @ {be_level}")

            elif (already_banked and gain >= 1.5 * init_sl_dist) or (news_locked and gain >= 0.6 * init_sl_dist):
                new_trail_sl = round(tick.ask + trail_dist, info.digits)
                if (new_trail_sl < pos.sl - (10 * info.point) or pos.sl == 0.0) and new_trail_sl <= be_level:
                    tr_res = mt5.order_send({"action": mt5.TRADE_ACTION_SLTP, "symbol": pos.symbol, "position": pos.ticket, "sl": new_trail_sl, "tp": pos.tp})
                    if tr_res and tr_res.retcode == mt5.TRADE_RETCODE_DONE:
                        events.append(f"📉 [{sleeve_id}] ATR TRAIL {pos.symbol} SL->{new_trail_sl}")

    return events

def has_sleeve_conflict(symbol: str) -> bool:
    open_pos = mt5.positions_get() or []
    open_ord = mt5.orders_get() or []
    for p in open_pos:
        if p.symbol == symbol:
            return True
    for o in open_ord:
        if o.symbol == symbol:
            return True
    for _, members in CORRELATION_CLUSTERS.items():
        if symbol in members:
            if sum(1 for p in open_pos if p.symbol in members) >= 2:
                return True
    return False

def dispatch_sleeve_order(sleeve_id: str, sleeve_cfg: dict, sig: dict, equity: float) -> tuple[str, bool]:
    sym = sig["symbol"]
    direction = sig["dir"]
    conf = sig["conf"]
    magic = sleeve_cfg["magic"]
    acc_id = sleeve_cfg["login"]

    term = mt5.terminal_info()
    if not term or not term.trade_allowed:
        return f"🔴 [{sleeve_id}] ALGO-OFF {sym} ({conf}%)", False

    info = mt5.symbol_info(sym)
    tick = mt5.symbol_info_tick(sym)
    if not info or not tick or info.trade_mode != mt5.SYMBOL_TRADE_MODE_FULL:
        return f"⏸️ [{sleeve_id}] CLOSED {sym} ({conf}%)", False
    if abs(time.time() - tick.time) > 180 and "BTC" not in sym:
        return f"⏸️ [{sleeve_id}] WEEKEND {sym} ({conf}%)", False
    if has_sleeve_conflict(sym):
        return f"🛡️ [{sleeve_id}] HOLD/SHIELD {sym} ({conf}%)", False

    mkt_price = tick.ask if direction == "BUY" else tick.bid
    atr = sig["atr"] if sig["atr"] > 0 else (25000 * info.point if "BTC" in sym else 150 * info.point)

    if "BTC" in sym:
        btc_atr = sig.get("atr_m15", atr) if sig.get("atr_m15", 0.0) > 0 else atr
        sl_dist = max(25000 * info.point, btc_atr * 2.2)
    elif "XAU" in sym:
        sl_dist = max(350 * info.point, atr * 2.2)
    else:
        sl_dist = max(150 * info.point, atr * 2.2)
    tp_dist = sl_dist * 3.0

    lots, kelly_f = compute_half_kelly_lots(sym, sl_dist, equity, magic)
    fill_mode = mt5.ORDER_FILLING_IOC if (info.filling_mode & 2) else mt5.ORDER_FILLING_FOK
    stops_level_px = info.trade_stops_level * info.point

    fvg_mid = sig.get("fvg_mid", 0.0)
    use_fvg_limit = False
    if fvg_mid > 0:
        if direction == "BUY" and (mkt_price - fvg_mid) > max(stops_level_px * 1.5, 5 * info.point) and (mkt_price - fvg_mid) <= atr * 0.9:
            use_fvg_limit = True
        elif direction == "SELL" and (fvg_mid - mkt_price) > max(stops_level_px * 1.5, 5 * info.point) and (fvg_mid - mkt_price) <= atr * 0.9:
            use_fvg_limit = True

    t_start = time.perf_counter()
    if use_fvg_limit:
        entry_px = round(fvg_mid, info.digits)
        sl = round(entry_px - sl_dist if direction == "BUY" else entry_px + sl_dist, info.digits)
        tp = round(entry_px + tp_dist if direction == "BUY" else entry_px - tp_dist, info.digits)
        exp_ts = int((datetime.now(timezone.utc) + timedelta(minutes=STATE["fvg_limit_expiry_mins"])).timestamp())
        req = {
            "action": mt5.TRADE_ACTION_PENDING,
            "symbol": sym,
            "volume": lots,
            "type": mt5.ORDER_TYPE_BUY_LIMIT if direction == "BUY" else mt5.ORDER_TYPE_SELL_LIMIT,
            "price": entry_px,
            "sl": sl,
            "tp": tp,
            "deviation": 30,
            "magic": magic,
            "comment": f"NEXUS-{sleeve_id} FVG {conf}%",
            "type_time": mt5.ORDER_TIME_SPECIFIED,
            "expiration": exp_ts,
            "type_filling": fill_mode,
        }
        res = mt5.order_send(req)
        lat_ms = round((time.perf_counter() - t_start) * 1000.0, 1)
        if res and res.retcode == mt5.TRADE_RETCODE_DONE:
            register_tranche(res.order, sleeve_id, sl_dist)
            log_execution(sleeve_id, acc_id, res.order, sym, direction, "FVG_LIMIT", lots, entry_px, entry_px, 0.0, lat_ms, sl, tp, conf, sig["vpin"], sig["dii"], kelly_f, "PENDING")
            return f"🎯 [{sleeve_id}] FVG-LMT {direction} {sym} {lots}L @ {entry_px} ({conf}% | {lat_ms}ms)", True

    sl = round(mkt_price - sl_dist if direction == "BUY" else mkt_price + sl_dist, info.digits)
    tp = round(mkt_price + tp_dist if direction == "BUY" else mkt_price - tp_dist, info.digits)
    req = {
        "action": mt5.TRADE_ACTION_DEAL,
        "symbol": sym,
        "volume": lots,
        "type": mt5.ORDER_TYPE_BUY if direction == "BUY" else mt5.ORDER_TYPE_SELL,
        "price": mkt_price,
        "sl": sl,
        "tp": tp,
        "deviation": 30,
        "magic": magic,
        "comment": f"NEXUS-{sleeve_id} {conf}% K:{kelly_f*100:.1f}%",
        "type_time": mt5.ORDER_TIME_GTC,
        "type_filling": fill_mode,
    }
    res = mt5.order_send(req)
    lat_ms = round((time.perf_counter() - t_start) * 1000.0, 1)

    if res and res.retcode == mt5.TRADE_RETCODE_DONE:
        filled_px = res.price if res.price > 0 else mkt_price
        slip_pts = round(((filled_px - mkt_price) if direction == "BUY" else (mkt_price - filled_px)) / info.point, 1)
        register_tranche(res.order, sleeve_id, sl_dist)
        log_execution(sleeve_id, acc_id, res.order, sym, direction, "MARKET", lots, mkt_price, filled_px, slip_pts, lat_ms, sl, tp, conf, sig["vpin"], sig["dii"], kelly_f, "FILLED")
        return f"🚀 [{sleeve_id}] EXEC {direction} {sym} {lots}L @ {filled_px} ({conf}% | Slip:{slip_pts:+.1f}pt | {lat_ms}ms)", True

    return f"⚠️ [{sleeve_id}] REJECT {sym}: {res.retcode if res else 'None'}", False

