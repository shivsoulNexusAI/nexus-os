def run_nexus_cycle(force_broadcast: bool = False):
    sync_macro_calendar()

    tot_nav, tot_eq, tot_float, tot_free = 0.0, 0.0, 0.0, 0.0
    sleeve_headers = []
    scanner_map = {}
    exp_lines = []
    triggers = []
    urgent = force_broadcast
    tot_pos_cnt, tot_pend_cnt = 0, 0

    for sleeve_id, cfg in SLEEVES.items():
        if not mt5.initialize(path=cfg["path"], login=cfg["login"], password=cfg["password"], server=cfg["server"]):
            sleeve_headers.append(f"❌ {sleeve_id} (#{cfg['login']}): IPC OFFLINE")
            continue

        acc = mt5.account_info()
        term = mt5.terminal_info()
        if not acc or not term:
            mt5.shutdown()
            continue

        tot_nav += acc.balance
        tot_eq += acc.equity
        tot_float += acc.profit
        tot_free += acc.margin_free

        if sleeve_id not in STATE["sleeve_start_equity"]:
            STATE["sleeve_start_equity"][sleeve_id] = acc.equity

        s_start = STATE["sleeve_start_equity"][sleeve_id]
        s_dd = max(0.0, ((s_start - acc.equity) / max(1.0, s_start)) * 100.0)
        s_breaker = s_dd >= STATE["max_daily_dd_pct"]

        algo_icon = "🟢" if term.trade_allowed else "🔴"
        sleeve_headers.append(f"{algo_icon} {sleeve_id} #{acc.login}: Eq ${acc.equity:,.2f} ({acc.profit:+.2f}) | DD {s_dd:.2f}%")

        atr_map = {}
        for sym in cfg["symbols"]:
            mt5.symbol_select(sym, True)
            sig = evaluate_alpha_matrix(sym)
            sig["sleeve"] = sleeve_id
            atr_map[sym] = sig["atr"]
            scanner_map[sym] = sig

            req_gate = STATE["sleeve_gates"].get(sleeve_id, STATE["confidence_gate"])
            if sig["conf"] >= req_gate and sig["dir"] in ("BUY", "SELL"):
                if s_breaker:
                    triggers.append(f"🛑 [{sleeve_id}] DD BREAKER ({s_dd:.2f}%)")
                    urgent = True
                else:
                    st, fired = dispatch_sleeve_order(sleeve_id, cfg, sig, acc.equity)
                    triggers.append(st)
                    if fired:
                        urgent = True

        tr_events = manage_sleeve_positions(sleeve_id, cfg["magic"], atr_map)
        if tr_events:
            triggers = tr_events + triggers
            urgent = True

        s_pos = mt5.positions_get() or []
        s_ord = mt5.orders_get() or []
        tot_pos_cnt += len(s_pos)
        tot_pend_cnt += len(s_ord)

        for p in s_pos:
