    high_impact = []
    for url in feeds:
        try:
            resp = httpx.get(url, timeout=10.0, headers={"User-Agent": "QuantNexus-v5.5/1.0"})
            if resp.status_code == 200:
                for ev in resp.json():
                    if str(ev.get("impact", "")).lower() == "high" and ev.get("date"):
                        dt_utc = datetime.fromisoformat(ev["date"]).astimezone(timezone.utc)
                        high_impact.append({
                            "title": ev.get("title", "High-Impact Event"),
                            "country": str(ev.get("country", "")).upper(),
