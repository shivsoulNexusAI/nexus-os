def init_db():
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("""
        CREATE TABLE IF NOT EXISTS executions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            ts_utc TEXT,
            sleeve TEXT DEFAULT 'T1',
            account_id INTEGER DEFAULT 278061453,
            ticket INTEGER,
            symbol TEXT,
            direction TEXT,
            order_mode TEXT,
            volume REAL,
            signal_price REAL,
            filled_price REAL,
            slippage_pts REAL,
            latency_ms REAL,
            sl REAL,
            tp REAL,
            confidence REAL,
            vpin REAL,
            dii REAL,
            kelly_fraction REAL,
            status TEXT
        )
    """)
    existing_cols = {row[1] for row in cur.execute("PRAGMA table_info(executions)").fetchall()}
    for col_name, col_def in [
        ("sleeve", "TEXT DEFAULT 'T1'"),
        ("account_id", "INTEGER DEFAULT 278061453"),
        ("order_mode", "TEXT DEFAULT 'MARKET'"),
        ("signal_price", "REAL DEFAULT 0.0"),
        ("filled_price", "REAL DEFAULT 0.0"),
        ("slippage_pts", "REAL DEFAULT 0.0"),
        ("latency_ms", "REAL DEFAULT 0.0"),
    ]:
        if col_name not in existing_cols:
            cur.execute(f"ALTER TABLE executions ADD COLUMN {col_name} {col_def}")

    cur.execute("""
        CREATE TABLE IF NOT EXISTS tranche_state (
            ticket INTEGER PRIMARY KEY,
            sleeve TEXT DEFAULT 'T1',
            initial_sl_dist REAL,
            banked_partial INTEGER DEFAULT 0
        )
    """)
    tr_cols = {row[1] for row in cur.execute("PRAGMA table_info(tranche_state)").fetchall()}
    if "sleeve" not in tr_cols:
        cur.execute("ALTER TABLE tranche_state ADD COLUMN sleeve TEXT DEFAULT 'T1'")

    conn.commit()
    conn.close()

